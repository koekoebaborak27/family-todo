# Next.js が読み込む環境変数の見本。
# 実際の値を書いた .env.local はコミットしない（.gitignore で除外済み）。
# 使い方: このファイルを .env.local という名前でコピーし、実値を書く。
# NEXT_PUBLIC_ 接頭辞の変数はブラウザに公開されるため、秘密の値を入れない。

# Backend（Express on Cloudflare Workers）の起動先。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Google OAuth のクライアントID（公開情報。認可画面へ遷移するときに使う）。
# クライアントシークレットはBackendだけが持つ（apps/backend/.dev.vars.example参照）。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Web Push（VAPID）の公開鍵。apps/backend/.dev.vars の VAPID_PUBLIC_KEY と同じ値にする。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
