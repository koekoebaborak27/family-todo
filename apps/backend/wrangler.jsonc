{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-todo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // ローカル開発は `pnpm --filter backend dev`（= wrangler dev）でこのバインディングをそのまま使える。
  // 本番用のD1は2026-09-02にCloudflareダッシュボードで作成済み。マイグレーションの反映は
  // GitHub Actionsのdeployジョブが `wrangler d1 migrations apply --remote` で毎回自動的に行う
  // （.github/workflows/ci.yml 参照。未適用分だけが実行されるため、複数回実行しても安全）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-todo-db",
      "database_id": "c3044525-90de-4456-a159-83a75412a79a",
      "migrations_dir": "migrations",
    },
  ],

  // 期限接近・期限超過の通知バッチ（詳細設計: docs/specs/03_detail-design/family-todo/20_通知バッチ処理.md）。
  // 実行間隔は技術検証で15分おきに確定済み。バッチ本体（scheduled ハンドラの中身）は未実装。
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
}
