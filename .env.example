# 環境変数の見本。実値を書いた .env はコミットしない（.gitignore で除外済み）。
# 追加したら、この見本にもキーと説明を 1 行足すこと。

# 画面操作テスト（Playwright）の接続先。未設定なら http://localhost:3000 を使う。
E2E_BASE_URL=http://localhost:3000

# 画面操作テストで使うログイン情報（テスト用アカウント。実アカウントを書かない）。
# E2E_USER_ID=testuser
# E2E_USER_PASSWORD=

# DB を使う場合の接続文字列。実値は .env / .env.local 側に書く。
# DATABASE_URL=postgresql://app:password@localhost:5432/app_db
