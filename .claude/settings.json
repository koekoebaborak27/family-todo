{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(pnpm db:reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
